#!/usr/bin/env autodq
# %% [markdown] Schema contracts and drift monitoring
# Establish a trusted sales baseline, then validate a later registered batch.
# %% [Approved dataset]
DATASET '../datasets/sample/sales.csv' TARGET Revenue;
SET TYPE Date datetime FORMAT AUTO;
LET "Approved Sales" = CURRENT;
# %% [Schema contract]
CONTRACT sales_v1 FROM "Approved Sales"
    VERSION 1.0.0
    EXTRA COLUMNS warning
    INFER RANGES false
    INFER CATEGORIES true
    OVERWRITE;
CONTRACT sales_v1 REQUIRE "Transaction ID"
    TYPE integer NOT NULL UNIQUE
    SEVERITY error;
CONTRACT sales_v1 REQUIRE Revenue
    TYPE numeric NOT NULL MIN 0
    SEVERITY error;
CONTRACT sales_v1 REQUIRE Region
    TYPE string ALLOWED 'North,South,East,West,Central'
    SEVERITY warning;
CHECK CONTRACT sales_v1 ON "Approved Sales" FAIL ON error;
# %% [Drift baseline]
BASELINE sales_baseline FROM "Approved Sales" OVERWRITE;
CHECK DRIFT sales_baseline ON "Approved Sales"
    CONTRACT sales_v1
    SENSITIVITY normal
    FAIL ON warning;
# %% [Portable artifacts]
CONTRACT SAVE sales_v1
    TO '../reports/sales-schema-contract.json' OVERWRITE;
BASELINE SAVE sales_baseline
    TO '../reports/sales-drift-baseline.json' OVERWRITE;
# %% [Inventory]
CONTRACT LIST;
BASELINE LIST;
SESSION;
