#!/usr/bin/env autodq
# %% [markdown] Multi-echelon inventory management

This workflow analyzes a network inventory snapshot, explains its inferred
roles, summarizes every echelon, and produces bounded same-SKU rebalancing and
replenishment recommendations.
# %% [Load inventory network]
DATASET "../datasets/sample/inventory_network.csv";
# %% [Profile inventory data]
PROFILE;
# %% [Recognize inventory roles and policy]
INVENTORY SERVICE_LEVEL 95 HORIZON 14 TOP 20;
# %% [Review echelon and node positions]
INVENTORY NETWORK SERVICE_LEVEL 95 HORIZON 14 TOP 20;
# %% [Generate the rebalancing plan]
INVENTORY REBALANCE SERVICE_LEVEL 95 HORIZON 14 TOP 20;
# %% [Export a complete inventory report]
REPORT TO "../reports/inventory-network-report.html" STYLE executive OVERWRITE;

