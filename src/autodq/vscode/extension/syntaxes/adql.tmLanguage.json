{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ADQL",
  "scopeName": "source.adql",
  "patterns": [
    {"include": "#cell"},
    {"include": "#comments"},
    {"include": "#quotedIdentifiers"},
    {"include": "#strings"},
    {"include": "#booleanOptions"},
    {"include": "#numbers"},
    {"include": "#commands"},
    {"include": "#aggregateFunctions"},
    {"include": "#qualityMetrics"},
    {"include": "#qualityPredicates"},
    {"include": "#operators"},
    {"include": "#clauses"},
    {"include": "#actions"},
    {"include": "#options"},
    {"include": "#entities"},
    {"include": "#dataSources"},
    {"include": "#constants"},
    {"include": "#enumValues"},
    {"include": "#punctuation"},
    {"include": "#identifiers"}
  ],
  "repository": {
    "cell": {
      "match": "^\\s*(#|--)\\s*(%%)(?:\\s*\\[(.*?)\\]|\\s+(.*?))?\\s*$",
      "name": "meta.cell.adql",
      "captures": {
        "1": {"name": "punctuation.definition.comment.adql"},
        "2": {"name": "keyword.control.cell.adql"},
        "3": {"name": "entity.name.section.adql"},
        "4": {"name": "entity.name.section.adql"}
      }
    },
    "comments": {
      "patterns": [
        {"match": "^#!.*$", "name": "comment.line.shebang.adql"},
        {"match": "#.*$", "name": "comment.line.number-sign.adql"},
        {"match": "--.*$", "name": "comment.line.double-dash.adql"}
      ]
    },
    "quotedIdentifiers": {
      "begin": "`",
      "beginCaptures": {
        "0": {"name": "punctuation.definition.identifier.begin.adql"}
      },
      "end": "`",
      "endCaptures": {
        "0": {"name": "punctuation.definition.identifier.end.adql"}
      },
      "name": "variable.other.quoted.adql"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {"name": "punctuation.definition.string.begin.adql"}
          },
          "end": "\"",
          "endCaptures": {
            "0": {"name": "punctuation.definition.string.end.adql"}
          },
          "name": "string.quoted.double.adql",
          "patterns": [
            {"match": "\\\\.", "name": "constant.character.escape.adql"}
          ]
        },
        {
          "begin": "'",
          "beginCaptures": {
            "0": {"name": "punctuation.definition.string.begin.adql"}
          },
          "end": "'",
          "endCaptures": {
            "0": {"name": "punctuation.definition.string.end.adql"}
          },
          "name": "string.quoted.single.adql",
          "patterns": [
            {"match": "\\\\.", "name": "constant.character.escape.adql"}
          ]
        }
      ]
    },
    "numbers": {
      "match": "(?<![A-Za-z0-9_.])-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.adql"
    },
    "booleanOptions": {
      "match": "(?i)\\b(ALLOW_DUPLICATES|APPEND|APPLY_CLEANING|APPLY_FEATURES|APPROVE_ALL|CHARTS|CONTINUE_ON_ERROR|DAYFIRST|DISPLAY|EXCLUDE_LEAKAGE|EXPLAIN|GRID|IGNORE_INDEX|INCLUDE_MODEL|INFER_CATEGORIES|INFER_RANGES|LEGEND|LOAD_MODEL|MAKE_ACTIVE|NULLABLE|OVERWRITE|PREDICT|PREVIEW|RAISE_ON_ERROR|RECOMMENDED|REFRESH|REQUIRED|SAVE_WORKSPACE|TRAIN_MODEL|TRANSPARENT|UNCERTAINTY|UNIQUE|USE_ENGINEERED|UTC|VISUALIZE|YEARFIRST)\\b(\\s+)(FALSE|NO|OFF|ON|TRUE|YES|0|1)\\b",
      "captures": {
        "1": {"name": "storage.modifier.option.adql"},
        "3": {"name": "constant.language.boolean.adql"}
      }
    },
    "commands": {
      "match": "(?i)\\b(ACTION|ADD|APPROVE|ASSERT|AUDIT|AUTO|BASELINE|BLUE|BOTTLENECKS|CHECK|CLEAN|CLEANING|CONCAT|CONTRACT|CORRELATION|DASHBOARD|DATASET|DECIDE|DIAGNOSE|DOMAIN|DRIFT|DUPLICATES|EDIT|EXPLAIN|EXPORT|FEATURE|FEATURES|GALLERY|HEAD|HELP|HISTORY|INTERPRET|INVENTORY|KNOWLEDGE|KPI|LET|LIST|LOAD|MERGE|MISSING|MODEL|OPERATIONS|OPTIMIZE|OUTLIERS|PREDICT|PRESCRIBE|PREVIEW|PROCESS|PROFILE|READINESS|RECOMMEND|REJECT|REPORT|REVIEW|ROOT|SAMPLE|SCENARIO|SCHEMA|SELECT|SESSION|SET|SHAP|STATISTICS|TAIL|USE|VALIDATE|VISUALIZE|WORKSPACE)\\b",
      "name": "keyword.control.adql"
    },
    "aggregateFunctions": {
      "match": "(?i)\\b(AVG|COUNT|MAX|MEAN|MEDIAN|MIN|NUNIQUE|SUM)\\b(?=\\s*\\()",
      "name": "support.function.aggregate.adql"
    },
    "qualityMetrics": {
      "match": "(?i)\\b(COLUMN_COUNT|DISTINCT_COUNT|DUPLICATE_PERCENT|DUPLICATE_ROWS|MISSING_COUNT|MISSING_PERCENT|QUALITY_SCORE|ROW_COUNT)\\b",
      "name": "support.function.quality-metric.adql"
    },
    "qualityPredicates": {
      "match": "(?i)\\b(BETWEEN|EXISTS|FAIL|FORMAT|MATCHES|NOT\\s+NULL)\\b",
      "name": "keyword.control.quality.adql"
    },
    "operators": {
      "match": "(?i)(<=|>=|!=|=|<|>|\\bIS\\s+NOT\\s+NULL\\b|\\bIS\\s+NULL\\b|\\bNOT\\s+IN\\b|\\bSTARTS\\s+WITH\\b|\\bENDS\\s+WITH\\b|\\bAND\\b|\\bOR\\b|\\bIN\\b|\\bCONTAINS\\b)",
      "name": "keyword.operator.adql"
    },
    "clauses": {
      "match": "(?i)\\b(GROUP\\s+BY|ORDER\\s+BY|ASC|AS|DESC|DISTINCT|FROM|LIMIT|ON|TO|USING|WHERE|WITH)\\b",
      "name": "keyword.other.clause.adql"
    },
    "actions": {
      "match": "(?i)\\b(ADD|APPLY|APPROVE|AUDIT|CAUSE|CLEAR|CREATE|CUSTOMIZE|DETECT|DROP|EVENTS|EXECUTE|EXPORT|FILL|GET|INFO|INTERPRET|LIST|LOAD|NETWORK|OPEN|PRESCRIBE|REBALANCE|REJECT|REMOVE|REQUIRE|REVIEW|RUN|SAVE|SHOW|SUMMARY|TREAT|VALIDATE|VISUALIZE)\\b",
      "name": "storage.type.action.adql"
    },
    "options": {
      "match": "(?i)\\b(ACTIONS|ACTOR|ALGORITHM|ALLOW_DUPLICATES|ALLOWED|APPEND|APPLY_CLEANING|APPLY_FEATURES|APPROVE_ALL|AXIS|BACKORDER|BINS|BUDGET|CAPACITY|CAPACITY_CHANGE|CHANGES|CHART|CHART_IDS|CHARTS|COLOR|COLUMN|COLUMNS|CONFIDENCE|CONFIDENCE_LEVEL|CONTINUE_ON_ERROR|COST|COST_CHANGE|DAYFIRST|DECIMALS|DEMAND|DEMAND_CHANGE|DESCRIPTION|DISPLAY|DPI|DURATION|DURATION_CHANGE|ECHELON|END|ENTITY|EXCLUDE|EXCLUDE_LEAKAGE|EXPRESSION|EXTRA_COLUMNS|FAILURE_CHANGE|FAIL_ON|FEATURE|FIGSIZE|FORMAT|GRID|GROUP|GROUP_BY|HORIZON|HOW|IGNORE_INDEX|INCLUDE_MODEL|INFER_CATEGORIES|INFER_RANGES|IQR|ITEM|JOIN|KEEP|LABELS|LEAD_TIME|LEAD_TIME_CHANGE|LEAKAGE_THRESHOLD|LEFT_ON|LEGEND|LEGEND_POSITION|LOAD_MODEL|LOCATION|LOWER|LOW_CONFIDENCE|LOW_CONFIDENCE_THRESHOLD|MAKE_ACTIVE|MAX|MAXIMUM|MAX_ACTIONS|MAX_CHARTS|MAX_FEATURES|MAX_RISK|MAX_ROWS|METHOD|MIN|MINIMUM|MIN_ABS|MIN_CONFIDENCE|MIN_PERCENT|MISSING_ERROR|MISSING_WARNING|MODE|MODEL_NAME|NAME|NAMES|NULLABLE|OBJECTIVE|ON_HAND|ON_ORDER|OUTPUT|OVERWRITE|PALETTE|PARENT|PATTERN|PERIOD|PSI_ERROR|PSI_WARNING|QUANTITY|RANDOM_STATE|RAISE_ON_ERROR|REASON|RECOMMENDED|REFERENCE|REFRESH|REPORT_OUTPUT|REPORT_STYLE|REQUIRED|RIGHT_ON|ROOT|SAFETY_STOCK|SAVE_WORKSPACE|SENSITIVITY|SERVICE_LEVEL|SEVERITY|SIGNIFICANCE|SLA|SOURCE|STAGE|START|STATUS|STRATEGY|STYLE|SUBTITLE|SUFFIXES|TARGET|TEMPLATE|TEST_SIZE|THEME|TIME|TITLE|TOP|TRAIN_MODEL|TRANSPARENT|TYPE|UNCERTAINTY|UNIQUE|UNIT_COST|UPPER|USE_ENGINEERED|UTC|VALUE|VALUE_CHANGE|VERSION|X|X_LABEL|Y|YEARFIRST|Y_LABEL)\\b",
      "name": "storage.modifier.option.adql"
    },
    "entities": {
      "match": "(?i)\\b(BASELINE|BASELINES|CONTRACT|CONTRACTS|DATASET|DATASETS|ROW|ROWS|SUITE|SUITES|TEST|TESTS|VISUALIZATION|VISUALIZATIONS|WORKSPACE|WORKSPACES)\\b",
      "name": "support.type.entity.adql"
    },
    "dataSources": {
      "match": "(?i)\\b(CLEANED|CURRENT|DATA|ENGINEERED|FEATURES|PREDICTIONS|RAW)\\b",
      "name": "constant.language.data-source.adql"
    },
    "constants": {
      "match": "(?i)\\b(ALL|FALSE|NO|NONE|NULL|OFF|ON|TRUE|YES)\\b",
      "name": "constant.language.adql"
    },
    "enumValues": {
      "match": "(?i)\\b(ANY|APPROVED|AUTO|BALANCED|BALANCE_CAPACITY|BAR|BEESWARM|BFILL|BOOLEAN|BOOL|BOX|BOXPLOT|CATEGORY|CATEGORICAL|CLASSIFICATION|CLEAN|CLEANING_STATUS|COMPARISON|CONSTANT|CORRELATION_HEATMAP|DARK|DATE|DATETIME|DAY|DECIMAL|DECISION_TREE_CLASSIFIER|DECISION_TREE_REGRESSOR|DEPENDENCE|DISTRIBUTION|EMAIL|ERROR|EXECUTED|EXECUTIVE|FFILL|FIRST|FLOAT|FULL|HEATMAP|HIGH|HISTOGRAM|IGNORE|INCREASE_VALUE|INFO|INFER|INT|INTEGER|INTERPOLATE|ISO|ISO8601|ISSUE_BREAKDOWN|JOURNAL|LAST|LIGHT|LINE|LINEAR_REGRESSION|LOGISTIC_REGRESSION|LOW|MAJOR|MAXIMIZE_CAPACITY|MAXIMIZE_VALUE|MEAN|MEDIAN|MEDIUM|MINIMIZE_COST|MINIMIZE_DELAY|MINIMIZE_FAILURES|MINIMIZE_SHORTAGE|MISSING_VALUES|MIXED|MODE|MODERATE|MONTH|NEVER|NORMAL|NUMBER|NUMERIC|PIE|PRESENTATION|PROPOSED|QUALITY_SCORE|RANDOM_FOREST_CLASSIFIER|RANDOM_FOREST_REGRESSOR|REDUCE_COST|REDUCE_DELAY|REDUCE_FAILURES|REDUCE_SHORTAGE|REGRESSION|REJECTED|RELAXED|REVIEW|SCATTER|SELECTED|STABLE|STRICT|STR|STRING|SUMMARY|TEXT|TIMESTAMP|TRAINED_MODEL|WARNING|WATERFALL|WEEK|ZERO)\\b",
      "name": "constant.other.enum.adql"
    },
    "punctuation": {
      "patterns": [
        {"match": ";", "name": "punctuation.terminator.statement.adql"},
        {"match": ",", "name": "punctuation.separator.sequence.adql"},
        {"match": "\\*", "name": "constant.other.wildcard.adql"},
        {"match": "[()]", "name": "punctuation.section.group.adql"},
        {"match": "[\\[\\]]", "name": "punctuation.section.brackets.adql"},
        {"match": "[{}]", "name": "punctuation.section.mapping.adql"},
        {"match": ":", "name": "punctuation.separator.key-value.adql"},
        {"match": "\\.", "name": "punctuation.accessor.adql"}
      ]
    },
    "identifiers": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.readwrite.adql"
    }
  }
}
